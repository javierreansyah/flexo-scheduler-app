{
  "name": "@flexo/web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "wrangler pages dev out",
    "lint": "pnpm typecheck && pnpm lint:ui && pnpm lint:css",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:ui": "oxlint --deny-warnings .",
    "lint:css": "stylelint \"app/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check app components hooks lib e2e *.json *.mjs .oxlintrc.json AGENTS.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "^3.13.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "papaparse": "^5.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@shadcn/lint": "^0.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/papaparse": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.90.0",
    "stylelint": "^17.16.0",
