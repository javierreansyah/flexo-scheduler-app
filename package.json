{
  "name": "flexo-scheduling",
  "private": true,
  "scripts": {
    "dev": "pnpm wasm:build && next dev",
    "build": "pnpm wasm:build && next build",
    "preview": "wrangler dev",
    "lint": "pnpm typecheck && pnpm lint:ui && pnpm lint:css",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:ui": "oxlint --deny-warnings .",
    "lint:css": "stylelint \"app/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check app components hooks lib engine/*.ts scripts e2e *.json *.mjs *.ts *.md .oxlintrc.json",
    "wasm:setup": "node scripts/wasm-setup.mjs",
    "wasm:build": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "^3.13.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "papaparse": "^5.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@shadcn/lint": "^0.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/papaparse": "^5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.90.0",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vitest": "^3",
    "wrangler": "^4",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
